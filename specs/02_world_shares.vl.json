{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Proportional symbol world map of each country or region's share of the decade's widely seen films, with a decade slider; the United States peaks at 55% in the 1990s, and Malaysia is ringed in red.",
  "padding": {"left": 0, "top": 5, "right": 5, "bottom": 5},
  "title": {
    "text": [
      "Hollywood peaked in the 1990s,",
      "then a different world came back"
    ],
    "subtitle": [
      "Circle area shows each country or region's share",
      "of the decade's widely seen films"
    ],
    "dx": {"expr": "textInset"}
  },
  "width": 760,
  "height": 350,
  "usermeta": {"aspect": 0.46},
  "params": [
    {
      "name": "decadeSel",
      "value": 1990,
      "bind": {
        "input": "range",
        "min": 1970,
        "max": 2020,
        "step": 10,
        "name": "Decade"
      }
    },
    {
      "name": "textInset",
      "expr": "max(0, (containerSize()[0] - 770) / 2)"
    },
    {"name": "narrow", "expr": "containerSize()[0] < 450"},
    {
      "name": "legendRows",
      "expr": "narrow ? 3 : containerSize()[0] < 666 ? 2 : 1"
    },
    {
      "name": "zoomTo",
      "value": "World",
      "bind": {
        "input": "radio",
        "options": ["World", "North America", "Europe", "Asia"],
        "name": "Zoom to"
      }
    },
    {
      "name": "zoomBox",
      "expr": "zoomTo === 'North America' ? [-127, 18, -66, 55] : zoomTo === 'Europe' ? [-11, 35, 35, 62] : zoomTo === 'Asia' ? [66, -11, 146, 46] : [-180, -56, 180, 84]"
    }
  ],
  "projection": {
    "type": "equalEarth",
    "fit": {
      "expr": "{type: 'MultiPoint', coordinates: [[zoomBox[0], zoomBox[1]], [zoomBox[2], zoomBox[1]], [zoomBox[0], zoomBox[3]], [zoomBox[2], zoomBox[3]], [zoomBox[0], clamp(0, zoomBox[1], zoomBox[3])], [zoomBox[2], clamp(0, zoomBox[1], zoomBox[3])], [(zoomBox[0] + zoomBox[2]) / 2, zoomBox[1]], [(zoomBox[0] + zoomBox[2]) / 2, zoomBox[3]]]}"
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/world-110m.topojson",
        "format": {"type": "topojson", "feature": "countries"}
      },
      "transform": [{"filter": "datum.id !== 10"}],
      "mark": {
        "type": "geoshape",
        "fill": "#EDE8E0",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.5,
        "clip": true
      }
    },
    {
      "data": {
        "url": "data/02d_country_shares_wide.csv",
        "format": {
          "type": "csv",
          "parse": {
            "iso_num": "number",
            "d1970": "number",
            "d1980": "number",
            "d1990": "number",
            "d2000": "number",
            "d2010": "number",
            "d2020": "number",
            "lon": "number",
            "lat": "number"
          }
        }
      },
      "transform": [
        {"calculate": "datum['d' + decadeSel]", "as": "share_pct"},
        {"filter": "isValid(datum.share_pct) && datum.share_pct > 0"},
        {
          "calculate": "indexof(['Africa', 'Oceania', 'Middle East & Central Asia'], datum.region) >= 0 ? 'Rest of the world' : datum.region",
          "as": "region6"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "circle",
            "opacity": 0.8,
            "stroke": "#FFFFFF",
            "strokeWidth": 0.8,
            "clip": true
          },
          "encoding": {
            "longitude": {"field": "lon", "type": "quantitative"},
            "latitude": {"field": "lat", "type": "quantitative"},
            "size": {
              "field": "share_pct",
              "type": "quantitative",
              "title": "Share of the decade's films",
              "scale": {
                "type": "linear",
                "domain": [0, 60],
                "range": [0, {"expr": "narrow ? 5200 * width / 760 : 5200"}]
              },
              "legend": {
                "orient": "none",
                "legendX": {"expr": "textInset"},
                "legendY": {"expr": "height + 14"},
                "direction": "horizontal",
                "titleOrient": {"expr": "narrow ? 'top' : 'left'"},
                "titlePadding": {"expr": "narrow ? 6 : 12"},
                "columnPadding": 18,
                "values": [1, 10, 30],
                "labelExpr": "datum.value + '%'",
                "symbolFillColor": "#B8B0A5",
                "symbolStrokeColor": "#FFFFFF",
                "symbolOpacity": 0.9
              }
            },
            "color": {
              "field": "region6",
              "type": "nominal",
              "title": "Region",
              "scale": {
                "domain": [
                  "North America",
                  "Europe",
                  "East Asia",
                  "South & Southeast Asia",
                  "Latin America",
                  "Rest of the world"
                ]
              },
              "legend": {
                "orient": "none",
                "legendX": {"expr": "textInset"},
                "legendY": {"expr": "-32 - (legendRows - 1) * 17"},
                "columns": {"expr": "legendRows === 3 ? 2 : legendRows === 2 ? 3 : 0"},
                "direction": "horizontal",
                "title": null,
                "symbolType": "circle",
                "symbolOpacity": 0.85,
                "columnPadding": 14
              }
            },
            "order": {
              "field": "share_pct",
              "type": "quantitative",
              "sort": "descending"
            },
            "tooltip": [
              {"field": "country", "type": "nominal", "title": "title"},
              {"field": "region6", "type": "nominal", "title": "Region"},
              {
                "field": "share_pct",
                "type": "quantitative",
                "format": ".2f",
                "title": "% of the decade's films"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "window": [{"op": "row_number", "as": "rank"}],
              "sort": [{"field": "share_pct", "order": "descending"}]
            },
            {"filter": "datum.rank === 1"},
            {"calculate": "format(datum.share_pct, '.0f') + '%'", "as": "label"}
          ],
          "mark": {
            "type": "text",
            "color": "#FFFFFF",
            "fontSize": 14,
            "fontWeight": 600,
            "clip": true
          },
          "encoding": {
            "longitude": {"field": "lon", "type": "quantitative"},
            "latitude": {"field": "lat", "type": "quantitative"},
            "text": {"field": "label"},
            "tooltip": [
              {"field": "country", "type": "nominal", "title": "title"},
              {"field": "region6", "type": "nominal", "title": "Region"},
              {
                "field": "share_pct",
                "type": "quantitative",
                "format": ".2f",
                "title": "% of the decade's films"
              }
            ]
          }
        }
      ]
    },
    {
      "data": {
        "url": "data/02d_country_shares_wide.csv",
        "format": {
          "type": "csv",
          "parse": {
            "iso_num": "number",
            "d1970": "number",
            "d1980": "number",
            "d1990": "number",
            "d2000": "number",
            "d2010": "number",
            "d2020": "number",
            "lon": "number",
            "lat": "number"
          }
        }
      },
      "transform": [
        {"filter": "datum.iso_num === 458"},
        {
          "calculate": "isValid(datum['d' + decadeSel]) ? format(datum['d' + decadeSel], '.2r') : 'none recorded'",
          "as": "share_label"
        }
      ],
      "encoding": {
        "tooltip": [
          {"field": "country", "type": "nominal", "title": "title"},
          {"field": "region", "type": "nominal", "title": "Region"},
          {"field": "share_label", "type": "nominal", "title": "% of the decade's films"}
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "point",
            "shape": "circle",
            "size": 70,
            "filled": false,
            "opacity": 1,
            "color": "#E63946",
            "strokeWidth": 2,
            "clip": true
          },
          "encoding": {
            "longitude": {"field": "lon", "type": "quantitative"},
            "latitude": {"field": "lat", "type": "quantitative"}
          }
        },
        {
          "mark": {
            "type": "text",
            "dy": 16,
            "color": "#B3202D",
            "fontWeight": 600,
            "clip": true
          },
          "encoding": {
            "longitude": {"field": "lon", "type": "quantitative"},
            "latitude": {"field": "lat", "type": "quantitative"},
            "text": {"value": "Malaysia"}
          }
        }
      ]
    },
    {
      "data": {"values": [{}]},
      "encoding": {"x": {"value": {"expr": "textInset"}}, "y": {"value": 2}},
      "layer": [
        {
          "mark": {
            "type": "text",
            "text": {"expr": "decadeSel === 2020 ? '2020–22' : decadeSel + 's'"},
            "align": "left",
            "baseline": "top",
            "font": "Inter, system-ui, sans-serif",
            "fontSize": {"expr": "narrow ? 18 : 24"},
            "fontWeight": 600,
            "color": "#6B6259",
            "stroke": "#FFFFFF",
            "strokeWidth": {"expr": "narrow ? 4 : 5"},
            "strokeJoin": "round"
          }
        },
        {
          "mark": {
            "type": "text",
            "text": {"expr": "decadeSel === 2020 ? '2020–22' : decadeSel + 's'"},
            "align": "left",
            "baseline": "top",
            "font": "Inter, system-ui, sans-serif",
            "fontSize": {"expr": "narrow ? 18 : 24"},
            "fontWeight": 600,
            "color": "#6B6259"
          }
        }
      ]
    }
  ],
  "config": {
    "background": "#FFFFFF",
    "font": "Inter, system-ui, sans-serif",
    "title": {
      "font": "DM Serif Display, Georgia, serif",
      "fontSize": 18,
      "fontWeight": 400,
      "color": "#1F1B16",
      "anchor": "start",
      "subtitleFont": "Inter, system-ui, sans-serif",
      "subtitleFontSize": 14,
      "subtitleColor": "#6B6259",
      "subtitlePadding": 6,
      "offset": 14
    },
    "axis": {
      "labelFont": "Inter, system-ui, sans-serif",
      "labelFontSize": 12,
      "labelColor": "#6B6259",
      "titleFont": "Inter, system-ui, sans-serif",
      "titleFontSize": 12,
      "titleColor": "#6B6259",
      "titleFontWeight": 500,
      "gridColor": "#E5DFD6",
      "domainColor": "#D6CEC3",
      "tickColor": "#D6CEC3",
      "labelPadding": 4
    },
    "legend": {
      "labelFont": "Inter, system-ui, sans-serif",
      "labelFontSize": 12,
      "labelColor": "#1F1B16",
      "titleFont": "Inter, system-ui, sans-serif",
      "titleFontSize": 12,
      "titleColor": "#6B6259",
      "titleFontWeight": 600
    },
    "text": {
      "font": "Inter, system-ui, sans-serif",
      "fontSize": 12,
      "color": "#1F1B16"
    },
    "view": {"stroke": null},
    "range": {
      "category": [
        "#0072B2",
        "#009E73",
        "#E69F00",
        "#CC79A7",
        "#56B4E9",
        "#A39E96"
      ],
      "heatmap": [
        "#F2C77F",
        "#E49A3E",
        "#C8701A",
        "#9C4E0C",
        "#6B3206",
        "#3F1A02"
      ],
      "ramp": ["#F2C77F", "#E49A3E", "#C8701A", "#9C4E0C", "#6B3206", "#3F1A02"]
    }
  }
}
