{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Connected scatterplot of the median budget against the median box office of each year's 20 biggest films, averaged by decade on log scales; from the 1970s to the 2010s budgets rose about eightfold and box office about fourfold.",
  "padding": {"left": 0, "top": 5, "right": 5, "bottom": 5},
  "title": {
    "text": [
      "The money going in grew nearly twice as fast",
      "as the money coming out"
    ],
    "subtitle": [
      "Black dots: decade averages of each year's medians",
      "for its 20 biggest films (2025 US$, log scales).",
      "Grey dots: single years; dashed lines: 8×, 4×, 2× budget."
    ]
  },
  "width": 520,
  "height": 400,
  "params": [
    {"name": "narrow", "expr": "width < 360"}
  ],
  "data": {
    "url": "data/03_budget_revenue_year.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "pool": "number",
        "budget_films": "number",
        "median_budget_musd": "number",
        "median_revenue_musd": "number",
        "decade": "number"
      }
    }
  },
  "encoding": {
    "x": {
      "field": "median_budget_musd",
      "type": "quantitative",
      "scale": {"type": "log", "domain": [10, 300], "nice": false},
      "title": "Median budget (US$m, 2025 dollars)",
      "axis": {"values": [10, 20, 50, 100, 200], "format": "d"}
    },
    "y": {
      "field": "median_revenue_musd",
      "type": "quantitative",
      "scale": {"type": "log", "domain": [100, 1200], "nice": false},
      "title": "Median box office (US$m, 2025 dollars)",
      "axis": {"values": [100, 200, 500, 1000], "format": "d"}
    }
  },
  "layer": [
    {
      "data": {
        "values": [
          {"median_budget_musd": 12.5, "median_revenue_musd": 100, "k": 8},
          {"median_budget_musd": 150, "median_revenue_musd": 1200, "k": 8},
          {"median_budget_musd": 25, "median_revenue_musd": 100, "k": 4},
          {"median_budget_musd": 300, "median_revenue_musd": 1200, "k": 4},
          {"median_budget_musd": 50, "median_revenue_musd": 100, "k": 2},
          {"median_budget_musd": 300, "median_revenue_musd": 600, "k": 2}
        ]
      },
      "mark": {
        "type": "line",
        "color": "#B9B0A4",
        "strokeWidth": 1,
        "strokeDash": [4, 4]
      },
      "encoding": {
        "detail": {"field": "k", "type": "nominal"},
        "order": {"field": "median_budget_musd", "type": "quantitative"}
      }
    },
    {
      "data": {
        "values": [
          {"median_budget_musd": 150, "median_revenue_musd": 1200, "label": "box office = 8\u00d7 budget"},
          {"median_budget_musd": 300, "median_revenue_musd": 1200, "label": "4\u00d7"},
          {"median_budget_musd": 300, "median_revenue_musd": 600, "label": "2\u00d7"}
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "top",
        "dx": -6,
        "dy": 4,
        "fontSize": 12,
        "fontStyle": "italic",
        "color": "#6B6259"
      },
      "encoding": {"text": {"field": "label", "type": "nominal"}}
    },
    {
      "mark": {"type": "point", "filled": true, "size": 34, "color": "#CFC6BA", "opacity": 1}
    },
    {
      "transform": [{"filter": "datum.year === 2020"}],
      "layer": [
        {
          "mark": {
            "type": "text",
            "text": {"expr": "narrow ? ['2020:', 'cinemas closed'] : '2020: cinemas closed'"},
            "align": {"expr": "narrow ? 'center' : 'left'"},
            "baseline": {"expr": "narrow ? 'top' : 'middle'"},
            "dx": {"expr": "narrow ? 0 : 8"},
            "dy": {"expr": "narrow ? 30 : 1"},
            "fontSize": 12,
            "color": "#6B6259",
            "stroke": "#FFFFFF",
            "strokeWidth": 4
          }
        },
        {
          "mark": {
            "type": "text",
            "text": {"expr": "narrow ? ['2020:', 'cinemas closed'] : '2020: cinemas closed'"},
            "align": {"expr": "narrow ? 'center' : 'left'"},
            "baseline": {"expr": "narrow ? 'top' : 'middle'"},
            "dx": {"expr": "narrow ? 0 : 8"},
            "dy": {"expr": "narrow ? 30 : 1"},
            "fontSize": 12,
            "color": "#6B6259"
          }
        }
      ]
    },
    {
      "transform": [
        {
          "aggregate": [
            {"op": "mean", "field": "median_budget_musd", "as": "median_budget_musd"},
            {"op": "mean", "field": "median_revenue_musd", "as": "median_revenue_musd"}
          ],
          "groupby": ["decade"]
        },
        {
          "calculate": "datum.decade === 2020 ? '2020–22' : datum.decade + 's'",
          "as": "label"
        }
      ],
      "layer": [
        {
          "mark": {"type": "line", "color": "#1F1B16", "strokeWidth": 2},
          "encoding": {"order": {"field": "decade", "type": "quantitative"}}
        },
        {
          "transform": [{"filter": {"field": "decade", "oneOf": [1970, 1980]}}],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 10,
            "dy": 12,
            "fontSize": 13,
            "fontWeight": 600,
            "color": "#1F1B16"
          },
          "encoding": {"text": {"field": "label"}}
        },
        {
          "transform": [{"filter": {"field": "decade", "oneOf": [1990, 2000]}}],
          "mark": {
            "type": "text",
            "align": "right",
            "dx": -10,
            "dy": -8,
            "fontSize": 13,
            "fontWeight": 600,
            "color": "#1F1B16"
          },
          "encoding": {"text": {"field": "label"}}
        },
        {
          "transform": [{"filter": {"field": "decade", "oneOf": [2010, 2020]}}],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 10,
            "dy": 1,
            "fontSize": 13,
            "fontWeight": 600,
            "color": "#1F1B16"
          },
          "encoding": {"text": {"field": "label"}}
        }
      ]
    },
    {
      "description": "An invisible copy of the yearly dots with a larger hit area, drawn above the decade line and labels so that every dot shows its tooltip.",
      "mark": {"type": "point", "filled": true, "size": 80, "opacity": 0},
      "encoding": {
        "tooltip": [
          {"field": "year", "type": "quantitative", "format": "d", "title": "title"},
          {
            "field": "median_budget_musd",
            "type": "quantitative",
            "format": "$,.0f",
            "title": "Median budget (US$m)"
          },
          {
            "field": "median_revenue_musd",
            "type": "quantitative",
            "format": "$,.0f",
            "title": "Median box office (US$m)"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {"op": "mean", "field": "median_budget_musd", "as": "median_budget_musd"},
            {"op": "mean", "field": "median_revenue_musd", "as": "median_revenue_musd"}
          ],
          "groupby": ["decade"]
        },
        {
          "calculate": "datum.decade === 2020 ? '2020–22' : datum.decade + 's'",
          "as": "label"
        },
        {
          "calculate": "datum.median_revenue_musd / datum.median_budget_musd",
          "as": "ratio"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 90,
        "color": "#1F1B16",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.5,
        "opacity": 1
      },
      "encoding": {
        "tooltip": [
          {"field": "label", "type": "nominal", "title": "title"},
          {
            "field": "median_budget_musd",
            "type": "quantitative",
            "format": "$,.0f",
            "title": "Average median budget (US$m)"
          },
          {
            "field": "median_revenue_musd",
            "type": "quantitative",
            "format": "$,.0f",
            "title": "Average median box office (US$m)"
          },
          {
            "field": "ratio",
            "type": "quantitative",
            "format": ".1f",
            "title": "Box office ÷ budget"
          }
        ]
      }
    }
  ],
  "config": {
    "background": "#FFFFFF",
    "font": "Inter, system-ui, sans-serif",
    "title": {
      "font": "DM Serif Display, Georgia, serif",
      "fontSize": 18,
      "fontWeight": 400,
      "color": "#1F1B16",
      "anchor": "start",
      "subtitleFont": "Inter, system-ui, sans-serif",
      "subtitleFontSize": 14,
      "subtitleColor": "#6B6259",
      "subtitlePadding": 6,
      "offset": 14
    },
    "axis": {
      "labelFont": "Inter, system-ui, sans-serif",
      "labelFontSize": 12,
      "labelColor": "#6B6259",
      "titleFont": "Inter, system-ui, sans-serif",
      "titleFontSize": 12,
      "titleColor": "#6B6259",
      "titleFontWeight": 500,
      "gridColor": "#E5DFD6",
      "domainColor": "#D6CEC3",
      "tickColor": "#D6CEC3",
      "labelPadding": 4
    },
    "legend": {
      "labelFont": "Inter, system-ui, sans-serif",
      "labelFontSize": 12,
      "labelColor": "#1F1B16",
      "titleFont": "Inter, system-ui, sans-serif",
      "titleFontSize": 12,
      "titleColor": "#6B6259",
      "titleFontWeight": 600
    },
    "text": {
      "font": "Inter, system-ui, sans-serif",
      "fontSize": 12,
      "color": "#1F1B16"
    },
    "view": {"stroke": null},
    "range": {
      "category": [
        "#0072B2",
        "#009E73",
        "#E69F00",
        "#CC79A7",
        "#56B4E9",
        "#A39E96"
      ],
      "heatmap": [
        "#F2C77F",
        "#E49A3E",
        "#C8701A",
        "#9C4E0C",
        "#6B3206",
        "#3F1A02"
      ],
      "ramp": ["#F2C77F", "#E49A3E", "#C8701A", "#9C4E0C", "#6B3206", "#3F1A02"]
    }
  }
}
