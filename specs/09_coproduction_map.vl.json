{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Flow map of the pairs of countries or regions that co-produced at least 15 widely seen films from 1970 to 2022; pairs within Europe and North America made 80.7% of these films, and no Malaysian pair reaches 15.",
  "padding": {"left": 0, "top": 5, "right": 5, "bottom": 5},
  "title": {
    "text": [
      "Co-production is a North Atlantic club,",
      "and Malaysia is barely in the room"
    ],
    "subtitle": [
      "Pairs of countries or regions that co-produced",
      "15 or more widely seen films, 1970–2022"
    ],
    "dx": {"expr": "textInset"}
  },
  "params": [
    {
      "name": "textInset",
      "expr": "max(0, (containerSize()[0] - 770) / 2)"
    },
    {"name": "narrow", "expr": "width < 420"},
    {
      "name": "zoomTo",
      "value": "World",
      "bind": {
        "input": "radio",
        "options": ["World", "North America", "Europe", "Asia"],
        "name": "Zoom to"
      }
    },
    {
      "name": "zoomBox",
      "expr": "zoomTo === 'North America' ? [-127, 18, -66, 55] : zoomTo === 'Europe' ? [-11, 35, 35, 62] : zoomTo === 'Asia' ? [66, -11, 146, 46] : [-180, -56, 180, 84]"
    }
  ],
  "width": 760,
  "height": 350,
  "usermeta": {"aspect": 0.46},
  "projection": {
    "type": "equalEarth",
    "fit": {
      "expr": "{type: 'MultiPoint', coordinates: [[zoomBox[0], zoomBox[1]], [zoomBox[2], zoomBox[1]], [zoomBox[0], zoomBox[3]], [zoomBox[2], zoomBox[3]], [zoomBox[0], clamp(0, zoomBox[1], zoomBox[3])], [zoomBox[2], clamp(0, zoomBox[1], zoomBox[3])], [(zoomBox[0] + zoomBox[2]) / 2, zoomBox[1]], [(zoomBox[0] + zoomBox[2]) / 2, zoomBox[3]]]}"
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/world-110m.topojson",
        "format": {"type": "topojson", "feature": "countries"}
      },
      "transform": [{"filter": "datum.id !== 10"}],
      "mark": {
        "type": "geoshape",
        "fill": "#EDE8E0",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.5,
        "clip": true
      }
    },
    {
      "data": {
        "url": "data/09_map_coproduction_links.csv",
        "format": {
          "type": "csv",
          "parse": {
            "a_num": "number",
            "b_num": "number",
            "links": "number",
            "a_lon": "number",
            "a_lat": "number",
            "b_lon": "number",
            "b_lat": "number"
          }
        }
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#5E554C",
        "strokeOpacity": 0.4,
        "clip": true
      },
      "encoding": {
        "shape": {"field": "geo", "type": "geojson"},
        "strokeWidth": {
          "field": "links",
          "type": "quantitative",
          "title": "Films co-produced",
          "scale": {"type": "sqrt", "range": [0.4, 7]},
          "legend": {
            "orient": "none",
            "legendX": {"expr": "textInset"},
            "legendY": {"expr": "height + 14"},
            "values": [50, 500, 1400],
            "direction": "horizontal",
            "titleOrient": {"expr": "narrow ? 'top' : 'left'"},
            "titlePadding": {"expr": "narrow ? 6 : 12"},
            "columnPadding": {"expr": "narrow ? 12 : 18"},
            "symbolType": "stroke",
            "symbolSize": 400,
            "clipHeight": 16,
            "symbolStrokeColor": "#5E554C",
            "symbolOpacity": 0.7
          }
        },
        "tooltip": [
          {"field": "pair", "type": "nominal", "title": "title"},
          {
            "field": "links",
            "type": "quantitative",
            "format": ",",
            "title": "Films co-produced"
          }
        ]
      },
      "transform": [
        {
          "lookup": "a_num",
          "from": {
            "data": {
              "url": "data/02d_country_shares_wide.csv",
              "format": {"type": "csv", "parse": {"iso_num": "number"}}
            },
            "key": "iso_num",
            "fields": ["country"]
          },
          "as": ["a_name"]
        },
        {
          "lookup": "b_num",
          "from": {
            "data": {
              "url": "data/02d_country_shares_wide.csv",
              "format": {"type": "csv", "parse": {"iso_num": "number"}}
            },
            "key": "iso_num",
            "fields": ["country"]
          },
          "as": ["b_name"]
        },
        {"calculate": "datum.a_name + ' and ' + datum.b_name", "as": "pair"},
        {
          "calculate": "{type: 'LineString', coordinates: [[datum.a_lon, datum.a_lat], [datum.b_lon, datum.b_lat]]}",
          "as": "geo"
        }
      ]
    },
    {
      "data": {
        "values": [{"lon": 114.507, "lat": 3.5313, "label": "Malaysia"}]
      },
      "mark": {
        "type": "circle",
        "color": "#E63946",
        "opacity": 1,
        "size": 90,
        "stroke": "#FFFFFF",
        "strokeWidth": 1.2,
        "clip": true
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "tooltip": {"value": "Malaysia: no partnership reaches 15 films"}
      }
    },
    {
      "data": {"values": [{"lon": 114.507, "lat": 3.5313}]},
      "layer": [
        {
          "mark": {
            "type": "text",
            "text": {"expr": "narrow ? ['Malaysia: no pair', 'reaches 15 films'] : 'Malaysia: no pair reaches 15 films'"},
            "align": {"expr": "narrow ? 'right' : 'center'"},
            "dx": {"expr": "narrow ? -8 : 0"},
            "dy": {"expr": "narrow ? -6 : 16"},
            "fontSize": 12,
            "fontWeight": 600,
            "color": "#B3202D",
            "stroke": "#FFFFFF",
            "strokeWidth": 4,
            "strokeOpacity": 0.9,
            "clip": true
          }
        },
        {
          "mark": {
            "type": "text",
            "text": {"expr": "narrow ? ['Malaysia: no pair', 'reaches 15 films'] : 'Malaysia: no pair reaches 15 films'"},
            "align": {"expr": "narrow ? 'right' : 'center'"},
            "dx": {"expr": "narrow ? -8 : 0"},
            "dy": {"expr": "narrow ? -6 : 16"},
            "fontSize": 12,
            "fontWeight": 600,
            "color": "#B3202D",
            "clip": true
          }
        }
      ],
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"}
      }
    }
  ],
  "config": {
    "background": "#FFFFFF",
    "font": "Inter, system-ui, sans-serif",
    "title": {
      "font": "DM Serif Display, Georgia, serif",
      "fontSize": 18,
      "fontWeight": 400,
      "color": "#1F1B16",
      "anchor": "start",
      "subtitleFont": "Inter, system-ui, sans-serif",
      "subtitleFontSize": 14,
      "subtitleColor": "#6B6259",
      "subtitlePadding": 6,
      "offset": 14
    },
    "axis": {
      "labelFont": "Inter, system-ui, sans-serif",
      "labelFontSize": 12,
      "labelColor": "#6B6259",
      "titleFont": "Inter, system-ui, sans-serif",
      "titleFontSize": 12,
      "titleColor": "#6B6259",
      "titleFontWeight": 500,
      "gridColor": "#E5DFD6",
      "domainColor": "#D6CEC3",
      "tickColor": "#D6CEC3",
      "labelPadding": 4
    },
    "legend": {
      "labelFont": "Inter, system-ui, sans-serif",
      "labelFontSize": 12,
      "labelColor": "#1F1B16",
      "titleFont": "Inter, system-ui, sans-serif",
      "titleFontSize": 12,
      "titleColor": "#6B6259",
      "titleFontWeight": 600
    },
    "text": {
      "font": "Inter, system-ui, sans-serif",
      "fontSize": 12,
      "color": "#1F1B16"
    },
    "view": {"stroke": null},
    "range": {
      "category": [
        "#0072B2",
        "#009E73",
        "#E69F00",
        "#CC79A7",
        "#56B4E9",
        "#A39E96"
      ],
      "heatmap": [
        "#F2C77F",
        "#E49A3E",
        "#C8701A",
        "#9C4E0C",
        "#6B3206",
        "#3F1A02"
      ],
      "ramp": ["#F2C77F", "#E49A3E", "#C8701A", "#9C4E0C", "#6B3206", "#3F1A02"]
    }
  }
}
