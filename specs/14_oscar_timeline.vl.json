          },
          {"x1": 2014.5, "x2": 2026.5, "label": "Nine entries in twelve years"}
        ]
      },
      "transform": [{"calculate": "(datum.x1 + datum.x2) / 2", "as": "xm"}],
      "layer": [
        {
          "mark": {"type": "rule", "color": "#6B6259", "strokeWidth": 1},
          "encoding": {
            "x": {
              "field": "x1",
              "type": "quantitative",
              "scale": {
                "domain": [2003.4, 2026.6],
                "nice": false,
                "zero": false
              },
              "axis": null
            },
            "x2": {"field": "x2"},
            "y": {"value": 18}
          }
        },
        {
          "mark": {
            "type": "text",
            "color": "#6B6259",
            "baseline": "bottom",
            "dy": -3
          },
          "encoding": {
            "x": {
              "field": "xm",
              "type": "quantitative",
              "scale": {
                "domain": [2003.4, 2026.6],
                "nice": false,
                "zero": false
              },
              "axis": null
            },
            "y": {"value": 18},
            "text": {"field": "label"}
          }
        }
      ]
    },
    {
      "data": {
        "url": "data/14_malaysia_oscar_submissions.csv",
        "format": {
          "type": "csv",
          "parse": {"year": "number", "ceremony": "number"}
        }
      },
      "transform": [
        {
          "calculate": "datum.ceremony + (datum.ceremony % 100 >= 11 && datum.ceremony % 100 <= 13 ? 'th' : datum.ceremony % 10 === 1 ? 'st' : datum.ceremony % 10 === 2 ? 'nd' : datum.ceremony % 10 === 3 ? 'rd' : 'th') + ' Academy Awards'",
          "as": "ceremony_name"
        }
      ],
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": null,
          "scale": {"domain": [2003.4, 2026.6], "nice": false, "zero": false},
          "axis": null
        }
      },
      "layer": [
        {
          "mark": {
            "type": "square",
            "size": 676,
            "strokeWidth": 1.5,
            "opacity": 1
          },
          "encoding": {
            "y": {"value": 48},
            "fill": {
              "condition": {
                "test": "datum.result === 'Result pending'",
                "value": "#FFFFFF"
              },
              "value": "#E63946"
            },
            "stroke": {"value": "#E63946"},
            "strokeDash": {
              "condition": {
                "test": "datum.result === 'Result pending'",
                "value": [3, 2]
              },
              "value": [1, 0]
            },
            "tooltip": [
              {"field": "film", "type": "nominal", "title": "title"},
              {
                "field": "year",
                "type": "quantitative",
                "format": "d",
                "title": "Submitted"
              },
              {
                "field": "ceremony_name",
                "type": "nominal",
                "title": "Ceremony"
              },
              {"field": "result", "type": "nominal", "title": "Result"}
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "font": "Oswald, Inter, sans-serif",
            "fontSize": 12,
            "fontWeight": 600,
            "color": "#1F1B16",
            "baseline": "top"
          },
          "encoding": {
            "y": {"value": 81},
            "text": {"field": "year", "type": "quantitative", "format": "d"}
          }
        },
        {
          "transform": [{"filter": "datum.result === 'Result pending'"}],
          "mark": {"type": "text", "color": "#6B6259", "baseline": "top"},
          "encoding": {"y": {"value": 98}, "text": {"value": "pending"}}
        }
      ]
    }
