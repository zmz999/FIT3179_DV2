{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Proportional symbol world map of filming locations recorded in Wikidata from 1970 to 2022, with a decade slider; shoots cluster in North America and Europe, and Malaysia's eight shoots are marked in red.",
  "padding": {"left": 0, "top": 5, "right": 5, "bottom": 5},
  "title": {
    "text": [
      "Films come from everywhere now.",
      "They are still shot in the same few places."
    ],
    "subtitle": [
      "Filming locations recorded in Wikidata, 1970–2022.",
      "Circle area shows the number of shoots."
    ],
    "dx": {"expr": "textInset"}
  },
  "width": 760,
  "height": 350,
  "usermeta": {"aspect": 0.46},
  "params": [
    {
      "name": "eraSel",
      "value": 1960,
      "bind": {
        "input": "range",
        "min": 1960,
        "max": 2020,
        "step": 10,
        "name": "Decade"
      }
    },
    {
      "name": "textInset",
      "expr": "max(0, (containerSize()[0] - 770) / 2)"
    },
    {"name": "narrow", "expr": "containerSize()[0] < 600"},
    {"name": "dotScale", "expr": "narrow ? width / 760 : 1"},
    {
      "name": "zoomTo",
      "value": "World",
      "bind": {
        "input": "radio",
        "options": ["World", "North America", "Europe", "Asia"],
        "name": "Zoom to"
      }
    },
    {
      "name": "zoomBox",
      "expr": "zoomTo === 'North America' ? [-127, 18, -66, 55] : zoomTo === 'Europe' ? [-11, 35, 35, 62] : zoomTo === 'Asia' ? [66, -11, 146, 46] : [-180, -56, 180, 84]"
    }
  ],
  "projection": {
    "type": "equalEarth",
    "fit": {
      "expr": "{type: 'MultiPoint', coordinates: [[zoomBox[0], zoomBox[1]], [zoomBox[2], zoomBox[1]], [zoomBox[0], zoomBox[3]], [zoomBox[2], zoomBox[3]], [zoomBox[0], clamp(0, zoomBox[1], zoomBox[3])], [zoomBox[2], clamp(0, zoomBox[1], zoomBox[3])], [(zoomBox[0] + zoomBox[2]) / 2, zoomBox[1]], [(zoomBox[0] + zoomBox[2]) / 2, zoomBox[3]]]}"
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/world-110m.topojson",
        "format": {"type": "topojson", "feature": "countries"}
      },
      "transform": [{"filter": "datum.id !== 10"}],
      "mark": {
        "type": "geoshape",
        "fill": "#EDE8E0",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.5,
        "clip": true
      }
    },
    {
      "data": {
        "url": "data/B2_filming_locations_grid.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lon": "number",
            "lat": "number",
            "decade": "number",
            "shoots": "number"
          }
        }
      },
      "transform": [
        {"filter": "eraSel === 1960 || datum.decade === eraSel"},
        {
          "aggregate": [{"op": "sum", "field": "shoots", "as": "shoots"}],
          "groupby": ["lon", "lat", "place"]
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#8B440A",
        "opacity": 0.5,
        "stroke": "#FFFFFF",
        "strokeWidth": 0.3,
        "clip": true
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "size": {
          "field": "shoots",
          "type": "quantitative",
          "title": "Shoots",
          "scale": {
            "type": "linear",
            "zero": true,
            "domain": [0, 1642],
            "range": [3, {"expr": "3 + 1297 * dotScale"}]
          },
          "legend": {
            "orient": "none",
            "legendX": {"expr": "textInset"},
            "legendY": {"expr": "height + 14"},
            "values": [10, 100, 800],
            "direction": "horizontal",
            "titleOrient": "left",
            "titlePadding": 12,
            "columnPadding": 18
          }
        },
        "order": {"field": "shoots", "type": "quantitative", "sort": "descending"},
        "tooltip": [
          {"field": "place", "type": "nominal", "title": "title"},
          {
            "field": "shoots",
            "type": "quantitative",
            "format": ",",
            "title": "Shoots recorded nearby"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/B2_filming_locations_grid.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lon": "number",
            "lat": "number",
            "decade": "number",
            "shoots": "number"
          }
        }
      },
      "transform": [
        {"filter": "eraSel === 1960 || datum.decade === eraSel"},
        {
          "aggregate": [{"op": "sum", "field": "shoots", "as": "shoots"}],
          "groupby": ["lon", "lat", "place"]
        },
        {
          "lookup": "place",
          "from": {
            "data": {
              "url": "data/B2_filming_hubs.csv",
              "format": {"type": "csv", "parse": {"lon": "number", "lat": "number"}}
            },
            "key": "locLabel",
            "fields": ["lon", "lat"]
          },
          "as": ["hub_lon", "hub_lat"]
        },
        {
          "filter": {
            "field": "place",
            "oneOf": ["Los Angeles", "Vancouver", "London", "Hong Kong", "Toronto", "Paris", "Atlanta", "New York City"]
          }
        },
        {
          "filter": "!narrow || indexof(['Los Angeles', 'London', 'Hong Kong'], datum.place) >= 0"
        }
      ],
      "encoding": {
        "longitude": {"field": "hub_lon", "type": "quantitative"},
        "latitude": {"field": "hub_lat", "type": "quantitative"},
        "text": {"field": "place", "type": "nominal"},
        "tooltip": [
          {"field": "place", "type": "nominal", "title": "title"},
          {
            "field": "shoots",
            "type": "quantitative",
            "format": ",",
            "title": "Shoots recorded nearby"
          }
        ]
      },
      "layer": [
        {
          "transform": [{"filter": {"field": "place", "oneOf": ["Los Angeles", "Vancouver", "London", "Hong Kong", "Toronto"]}}],
          "mark": {
            "type": "text",
            "dy": {"expr": "narrow && datum.place === 'Los Angeles' ? 15 : -14"},
            "fontSize": 12,
            "fontWeight": 600,
            "color": "#1F1B16",
            "stroke": "#FFFFFF",
            "strokeWidth": 3,
            "strokeOpacity": 0.9,
            "clip": true
          }
        },
        {
          "transform": [{"filter": {"field": "place", "oneOf": ["Los Angeles", "Vancouver", "London", "Hong Kong", "Toronto"]}}],
          "mark": {
            "type": "text",
            "dy": {"expr": "narrow && datum.place === 'Los Angeles' ? 15 : -14"},
            "fontSize": 12,
            "fontWeight": 600,
            "color": "#1F1B16",
            "clip": true
          }
        },
        {
          "transform": [{"filter": {"field": "place", "oneOf": ["Paris", "Atlanta"]}}],
          "mark": {
            "type": "text",
            "dy": 15,
            "fontSize": 12,
            "fontWeight": 600,
            "color": "#1F1B16",
            "stroke": "#FFFFFF",
            "strokeWidth": 3,
            "strokeOpacity": 0.9,
            "clip": true
          }
        },
        {
          "transform": [{"filter": {"field": "place", "oneOf": ["Paris", "Atlanta"]}}],
          "mark": {
            "type": "text",
            "dy": 15,
            "fontSize": 12,
            "fontWeight": 600,
            "color": "#1F1B16",
            "clip": true
          }
        },
        {
          "transform": [{"filter": {"field": "place", "oneOf": ["New York City"]}}],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 10,
            "fontSize": 12,
            "fontWeight": 600,
            "color": "#1F1B16",
            "stroke": "#FFFFFF",
            "strokeWidth": 3,
            "strokeOpacity": 0.9,
            "clip": true
          }
        },
        {
          "transform": [{"filter": {"field": "place", "oneOf": ["New York City"]}}],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 10,
            "fontSize": 12,
            "fontWeight": 600,
            "color": "#1F1B16",
            "clip": true
          }
        }
      ]
    },
    {
      "data": {
        "url": "data/B2_malaysia_shoots.csv",
        "format": {
          "type": "csv",
          "parse": {"lon": "number", "lat": "number", "year": "number"}
        }
      },
      "transform": [
        {"calculate": "floor(datum.year / 10) * 10", "as": "decade"},
        {"filter": "eraSel === 1960 || datum.decade === eraSel"},
        {
          "aggregate": [{"op": "count", "as": "shoots"}],
          "groupby": ["lon", "lat", "place"]
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#E63946",
        "size": 40,
        "opacity": 0.95,
        "stroke": "#FFFFFF",
        "strokeWidth": 0.6,
        "clip": true
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "tooltip": [
          {"field": "place", "type": "nominal", "title": "title"},
          {
            "field": "shoots",
            "type": "quantitative",
            "title": "Shoots recorded"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/B2_filming_notes.csv",
        "format": {"type": "csv", "parse": {"era": "number", "n": "number", "lon": "number", "lat": "number"}}
      },
      "transform": [
        {"filter": "datum.era === eraSel && zoomTo === 'World' && isValid(datum.lon)"},
        {"calculate": "3 + datum.n / 1642 * 1297 * dotScale", "as": "circle_area"}
      ],
      "mark": {
        "type": "circle",
        "filled": false,
        "stroke": "#1F1B16",
        "strokeWidth": 1.5,
        "opacity": 1,
        "clip": true
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "size": {"field": "circle_area", "type": "quantitative", "scale": null},
        "tooltip": [
          {"field": "place", "type": "nominal", "title": "title"},
          {"field": "n", "type": "quantitative", "format": ",", "title": "Shoots recorded nearby"}
        ]
      }
    },
    {
      "data": {
        "url": "data/B2_filming_notes.csv",
        "format": {"type": "csv", "parse": {"era": "number", "n": "number", "p": "number"}}
      },
      "transform": [
        {"filter": "datum.era === eraSel && zoomTo === 'World'"},
        {
          "calculate": "[replace(replace(datum.line1, '{n}', format(datum.n, ',')), '{p}', format(datum.p, ',')), replace(replace(datum.line2, '{n}', format(datum.n, ',')), '{p}', format(datum.p, ','))]",
          "as": "note"
        }
      ],
      "encoding": {
        "x": {"value": {"expr": "textInset"}},
        "y": {"value": {"expr": "narrow ? height - 30 : height - 64"}},
        "text": {"field": "note"}
      },
      "layer": [
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "fontSize": {"expr": "narrow ? 11 : 13"},
            "lineHeight": {"expr": "narrow ? 14 : 17"},
            "color": "#1F1B16",
            "stroke": "#FFFFFF",
            "strokeWidth": 4,
            "strokeJoin": "round"
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "fontSize": {"expr": "narrow ? 11 : 13"},
            "lineHeight": {"expr": "narrow ? 14 : 17"},
            "color": "#1F1B16"
          }
        }
      ]
    },
    {
      "data": {
        "url": "data/B2_shoots_by_region.csv",
        "format": {"type": "csv", "parse": {"decade": "number", "shoots": "number"}}
      },
      "transform": [
        {"filter": "eraSel === 1960 || datum.decade === eraSel"},
        {"calculate": "datum.region === 'Africa' ? datum.shoots : 0", "as": "africa"},
        {
          "aggregate": [
            {"op": "sum", "field": "shoots", "as": "total"},
            {"op": "sum", "field": "africa", "as": "africa"}
          ]
        },
        {"filter": "zoomTo === 'World' && datum.total > 0"},
        {
          "calculate": "['Africa: ' + format(datum.africa / datum.total, '.1%'), eraSel === 1960 ? 'of all recorded shoots' : 'of the decade\\'s shoots']",
          "as": "note"
        },
        {"calculate": "21", "as": "lon"},
        {"calculate": "narrow ? -4 : -12", "as": "lat"}
      ],
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "note"}
      },
      "layer": [
        {
          "mark": {
            "type": "text",
            "fontSize": {"expr": "narrow ? 11 : 13"},
            "lineHeight": {"expr": "narrow ? 14 : 17"},
            "color": "#1F1B16",
            "stroke": "#FFFFFF",
            "strokeWidth": 4,
            "strokeJoin": "round",
            "clip": true
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": {"expr": "narrow ? 11 : 13"},
            "lineHeight": {"expr": "narrow ? 14 : 17"},
            "color": "#1F1B16",
            "clip": true
          }
        }
      ]
    },
    {
      "data": {"values": [{}]},
      "encoding": {"x": {"value": {"expr": "textInset"}}, "y": {"value": 2}},
      "layer": [
        {
          "mark": {
            "type": "text",
            "text": {"expr": "eraSel === 1960 ? 'All decades' : eraSel === 2020 ? '2020–22' : eraSel + 's'"},
            "align": "left",
            "baseline": "top",
            "font": "Inter, system-ui, sans-serif",
            "fontSize": {"expr": "narrow ? 18 : 24"},
            "fontWeight": 600,
            "color": "#6B6259",
            "stroke": "#FFFFFF",
            "strokeWidth": {"expr": "narrow ? 4 : 5"},
            "strokeJoin": "round"
          }
        },
        {
          "mark": {
            "type": "text",
            "text": {"expr": "eraSel === 1960 ? 'All decades' : eraSel === 2020 ? '2020–22' : eraSel + 's'"},
            "align": "left",
            "baseline": "top",
            "font": "Inter, system-ui, sans-serif",
            "fontSize": {"expr": "narrow ? 18 : 24"},
            "fontWeight": 600,
            "color": "#6B6259"
          }
        }
      ]
    }
  ],
  "config": {
    "background": "#FFFFFF",
    "font": "Inter, system-ui, sans-serif",
    "title": {
      "font": "DM Serif Display, Georgia, serif",
      "fontSize": 18,
      "fontWeight": 400,
      "color": "#1F1B16",
      "anchor": "start",
      "subtitleFont": "Inter, system-ui, sans-serif",
      "subtitleFontSize": 14,
      "subtitleColor": "#6B6259",
      "subtitlePadding": 6,
      "offset": 14
    },
    "axis": {
      "labelFont": "Inter, system-ui, sans-serif",
      "labelFontSize": 12,
      "labelColor": "#6B6259",
      "titleFont": "Inter, system-ui, sans-serif",
      "titleFontSize": 12,
      "titleColor": "#6B6259",
      "titleFontWeight": 500,
      "gridColor": "#E5DFD6",
      "domainColor": "#D6CEC3",
      "tickColor": "#D6CEC3",
      "labelPadding": 4
    },
    "legend": {
      "labelFont": "Inter, system-ui, sans-serif",
      "labelFontSize": 12,
      "labelColor": "#1F1B16",
      "titleFont": "Inter, system-ui, sans-serif",
      "titleFontSize": 12,
      "titleColor": "#6B6259",
      "titleFontWeight": 600
    },
    "text": {
      "font": "Inter, system-ui, sans-serif",
      "fontSize": 12,
      "color": "#1F1B16"
    },
    "view": {"stroke": null},
    "range": {
      "category": [
        "#0072B2",
        "#009E73",
        "#E69F00",
        "#CC79A7",
        "#56B4E9",
        "#A39E96"
      ],
      "heatmap": [
        "#F2C77F",
        "#E49A3E",
        "#C8701A",
        "#9C4E0C",
        "#6B3206",
        "#3F1A02"
      ],
      "ramp": ["#F2C77F", "#E49A3E", "#C8701A", "#9C4E0C", "#6B3206", "#3F1A02"]
    }
  }
}
