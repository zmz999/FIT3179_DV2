{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "padding": {"left": 0, "top": 5, "right": 5, "bottom": 5},
  "title": {
    "text": "Every country and region, one equal square",
    "subtitle": "Films that reached a wide audience, 1970–2022. Malaysia outlined."
  },
  "width": 720,
  "height": 580,
  "data": {
    "url": "data/B1_tilegrid_country_films.csv",
    "format": {
      "type": "csv",
      "parse": {
        "x": "number",
        "y": "number",
        "films_all": "number",
        "films_2000s_on": "number"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.5,
        "cornerRadius": 2
      },
      "encoding": {
        "color": {
          "field": "films_all",
          "type": "quantitative",
          "title": "Films",
          "scale": {
            "type": "symlog",
            "range": [
              "#FFF7E8",
              "#FBD9A0",
              "#F0A94C",
              "#C86E16",
              "#8A4308",
              "#4A2004"
            ]
          },
          "legend": {
            "orient": "none",
            "legendX": 470,
            "legendY": 8,
            "direction": "horizontal",
            "gradientLength": 170,
            "titleAnchor": "start"
          }
        }
      }
    },
    {
      "transform": [
        {"filter": "datum.is_malaysia === true || datum.is_malaysia === 'True'"}
      ],
      "mark": {
        "type": "rect",
        "fill": null,
        "stroke": "#E63946",
        "strokeWidth": 2.5,
        "cornerRadius": 2
      }
    },
    {
      "mark": {
        "type": "text",
        "font": "Inter, system-ui, sans-serif",
        "fontSize": 7
      },
      "encoding": {
        "text": {"field": "iso_a3", "type": "nominal"},
        "color": {
          "condition": {"test": "datum.films_all > 900", "value": "#FFFFFF"},
          "value": "#1F1B16"
        }
      }
    }
  ],
  "encoding": {
    "x": {
      "field": "x",
      "type": "ordinal",
      "axis": null,
      "scale": {"padding": 0.06}
    },
    "y": {
      "field": "y",
      "type": "ordinal",
      "axis": null,
      "scale": {"padding": 0.06}
    },
    "tooltip": [
      {"field": "country", "type": "nominal", "title": "Country or region"},
      {
        "field": "films_all",
        "type": "quantitative",
        "format": ".0f",
        "title": "Films"
      }
    ]
  },
  "config": {
    "background": "#FFFFFF",
    "font": "Inter, system-ui, sans-serif",
    "title": {
      "font": "Oswald, Inter, sans-serif",
      "fontSize": 19,
      "fontWeight": 600,
      "color": "#1F1B16",
      "anchor": "start",
      "subtitleFont": "Inter, system-ui, sans-serif",
      "subtitleFontSize": 14,
      "subtitleColor": "#6B6259",
      "subtitlePadding": 6,
      "offset": 14
    },
    "axis": {
      "labelFont": "Inter, system-ui, sans-serif",
      "labelFontSize": 12,
      "labelColor": "#6B6259",
      "titleFont": "Inter, system-ui, sans-serif",
      "titleFontSize": 12,
      "titleColor": "#6B6259",
      "titleFontWeight": 500,
      "gridColor": "#E5DFD6",
      "domainColor": "#D6CEC3",
      "tickColor": "#D6CEC3",
      "labelPadding": 4
    },
    "legend": {
      "labelFont": "Inter, system-ui, sans-serif",
      "labelFontSize": 12,
      "labelColor": "#1F1B16",
      "titleFont": "Inter, system-ui, sans-serif",
      "titleFontSize": 12,
      "titleColor": "#6B6259",
      "titleFontWeight": 600
    },
    "text": {
      "font": "Inter, system-ui, sans-serif",
      "fontSize": 12,
      "color": "#1F1B16"
    },
    "view": {"stroke": null},
    "range": {
      "category": [
        "#0072B2",
        "#009E73",
        "#E69F00",
        "#CC79A7",
        "#56B4E9",
        "#A39E96"
      ],
      "heatmap": [
        "#F2C77F",
        "#E49A3E",
        "#C8701A",
        "#9C4E0C",
        "#6B3206",
        "#3F1A02"
      ],
      "ramp": ["#F2C77F", "#E49A3E", "#C8701A", "#9C4E0C", "#6B3206", "#3F1A02"]
    }
  }
}
